# Copia este fichero a .env y ajusta lo que necesites

# Base de datos
DB_HOST=localhost
DB_PORT=3307
DB_NAME=catalogo
DB_USER=etailers
DB_PASSWORD=etailers

# API de stock del proveedor
STOCK_API_URL=http://localhost:3001/api/v1/stock
STOCK_API_TOKEN=etailers-demo-token

# Ficheros de entrada
CSV_PATH=./data/proveedor_productos.csv
XML_PATH=./data/tarifas_proveedor.xml

# F10: vacío desactiva el envío; configurar solo tras revisar el escenario/destinatario.
MAKE_WEBHOOK_URL=
MAKE_TIMEOUT=10
# Alerta si rows_rejected > umbral O low_stock_count > 0. Los duplicados no cuentan.
MAKE_REJECTION_THRESHOLD=0
